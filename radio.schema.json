{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central Rádios Brasil - Rádio",
  "type": "object",
  "required": [
    "id",
    "nome",
    "uf",
    "cidade",
    "categoriaPrincipal",
    "streams"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "nome": {
      "type": "string",
      "minLength": 2
    },
    "uf": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "cidade": {
      "type": "string",
      "minLength": 2
    },
    "categoriaPrincipal": {
      "type": "string",
      "minLength": 2
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "prioridade",
          "ativo"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "prioridade": {
            "type": "integer",
            "minimum": 1
          },
          "ativo": {
            "type": "boolean"
          }
        }
      }
    }
  }
}